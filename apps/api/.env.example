# GENERAL
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=https://app.cvmatch.localhost
COOKIE_DOMAIN=cvmatch.localhost
EMAIL_ADAPTER=mailhog

# DATABASE
DATABASE_URL=postgres://postgres:cvmatch@localhost:5432/cv_match
DATABASE_TEST_URL=postgres://postgres:cvmatch@localhost:5432/cv_match_test
REDIS_URL=redis://localhost:6379
BULLBOARD_PASSWORD=admin123

# MAILS
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# AWS
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true

FILE_STORAGE_ADAPTER=s3
AWS_BUCKET_NAME=cv-match-prod


# AI (CV analysis)
# Set AI_ADAPTER=mock to run the pipeline without an Anthropic API key.
# You can also set AI_ADAPTER=openai to use the OpenAI API.
# default is anthropic
AI_ADAPTER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# AUTH

BETTER_AUTH_SECRET=secret99secret99secret99secret99secret99
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=1111111111111-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example123


